{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "kitty-direct",
        "source": "/home/sicmundus/fastfetch-custom/arch-toji.png",
        "width": 40,
        "padding": {
            "top": 1,
            "left": 2,
            "right": 2
        }
    },
    "display": {
        "separator": " 󰁔 ",
        "color": {
            "separator": "90",
            "keys": "blue",
            "title": "cyan"
        }
    },
    "modules": [
        {
            "type": "command",
            "key": "  ",
            "keyColor": "blue",
            "text": "splash=$(hyprctl splash);echo $splash"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },
        {
            "type": "chassis",
            "key": "  󰇺 Chassis",
            "format": "{1} {2~0,10}"
        },
        {
            "type": "os",
            "key": "  󰣇 OS",
            "format": "{name} {arch}",
            "keyColor": "red"
        },
        {
            "type": "kernel",
            "key": "   Kernel",
            "format": "{2}",
            "keyColor": "red"
        },
        {
            "type": "packages",
            "key": "  󰏗 Packages",
            "format": "{pacman} (pacman), {nix-user} (nix)",
            "keyColor": "green"
        },
        {
            "type": "command",
            "key": "  󰏗 Arch User Repository",
            "text": "pacman -Qm | wc -l",
            "keyColor": "green"
        },
        {
            "type": "display",
            "key": "  󰍹 Display",
            "format": "{1}x{2} @ {3}Hz [{7}]",
            "keyColor": "green"
        },
        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "yellow"
        },
        {
            "type": "wm",
            "key": "  󱗃 WM",
            "format": "{pretty-name} {version} ({protocol-name})",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "title",
            "key": "  ",
            "format": "{6} {7} {8}"
        },
        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },
        {
            "type": "cpu",
            "format": "{1} @ {7}",
            "key": "   CPU",
            "keyColor": "blue"
        },
        {
            "type": "gpu",
            "format": "{name} [{type}]",
            "key": "  󰊴 GPU",
            "keyColor": "blue"
        },
        {
            "type": "command",
            "text": "glxinfo 2>/dev/null | grep 'OpenGL version' | sed 's/.*Mesa /amdgpu (Mesa /' | sed 's/$/)/' | awk '{print $1, $2, $3}'",
            "key": "   GPU Driver",
            "keyColor": "magenta"
        },
        {
            "type": "memory",
            "key": "   Memory ",
            "keyColor": "magenta"
        },
        {
            "type": "disk",
            "key": "   Root",
            "keyColor": "red",
            "folders": [
                "/"
            ],
            "format": "{size-used} / {size-total} ({size-percentage}%)"
        },
        {
            "type": "disk",
            "key": "   Home",
            "keyColor": "blue",
            "folders": [
                "/home"
            ],
            "format": "{size-used} / {size-total} ({size-percentage}%)"
        },
        {
            "type": "command",
            "key": "  󱦟 OS Age ",
            "keyColor": "red",
            "text": "bash -c 'DAYS=$(( ($(date +%s) - $(stat -c %W /)) / 86400 )); DATE=$(LC_TIME=C date -d @$(stat -c %W /) \"+%b %d, %Y\"); echo \"$DAYS days ($DATE)\"'"
        },
        {
            "type": "uptime",
            "key": "  󱫐 Uptime ",
            "keyColor": "red"
        },
        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },
        {
            "type": "colors",
            "symbol": "circle"
        },
        "break",
        "break",
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b7\u001b[14A\r\u001b[2C\u001b[3;38;5;146mI wasn't sure you'd wake up. I hoped you\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mwould. I wanted to show you...I don't\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mhave anyone else. I think a lot about\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mmeteors...the purity of them. BOOM! The\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mend. Start again. The world made clean\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mfor the new man to rebuild. I was meant\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mto be new. I was meant to be beautiful.\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mThe world would have looked to the sky\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mand seen hope...seen mercy. Instead,\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mthey will look up in horror because of\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146myou. You've wounded me. I give you full\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mmarks for that. Well, like the man said:\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146m'What doesn't kill you, just makes me\u001b[0m\u001b[1B\r\u001b[2C\u001b[3;38;5;146mstronger.'\u001b[0m\u001b[1B\u001b8"
        }
    ]
}
