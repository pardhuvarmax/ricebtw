{
    "explorer.confirmDelete": false,
    "explorer.confirmDragAndDrop": false,
    "makefile.configureOnOpen": true,
    "files.readonlyInclude": {
        "**/fabric-snapshots/**": true
    },
    "chat.modeFilesLocations": {
        ".github/chatmodes": true,
        "/home/sicmundus/.vscode-insiders/extensions/synapsevscode.synapse-1.25.1/copilot/chatmodes": true
    },
    "jupyter.jupyterLaunchTimeout": 600000,
    "synapse.localWorkFolderPath": "/home/sicmundus/Desktop/Dev/scratchpad",
    "editor.tabCompletion": "onlySnippets",
    "workbench.colorCustomizations": {},
    "workbench.colorTheme": "Dark Magic OLED",
    "jupyter.askForKernelRestart": false,
    "git.confirmSync": false,
    "security.workspace.trust.untrustedFiles": "open",
    "explorer.fileNesting.patterns": {
        "*.ts": "${capture}.js",
        "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
        "*.jsx": "${capture}.js",
        "*.tsx": "${capture}.ts",
        "tsconfig.json": "tsconfig.*.json",
        "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
        "*.sqlite": "${capture}.${extname}-*",
        "*.db": "${capture}.${extname}-*",
        "*.sqlite3": "${capture}.${extname}-*",
        "*.db3": "${capture}.${extname}-*",
        "*.sdb": "${capture}.${extname}-*",
        "*.s3db": "${capture}.${extname}-*"
    },
    "terminal.integrated.initialHint": false,
    "claudeCode.preferredLocation": "panel",
    "gitlens.graph.changesColumn.enabled": true,
    "gitlens.graph.details.location": "auto",
    "workbench.editor.enablePreview": false,
    "extensions.experimental.affinity": {
        "asvetliakov.vscode-neovim": 1
    },
    "chat.viewSessions.orientation": "stacked"
}